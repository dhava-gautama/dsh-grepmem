{
  "name": "@local/dsh-grepmem",
  "version": "1.1.1",
  "private": true,
  "description": "GrepMem-style lossless history recall for DeepSeek Harness: regex-search the current session or earlier workspace sessions, including content removed by compaction.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "grep-worker.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "grep",
    "compaction"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhava-gautama/dsh-grepmem.git"
  },
  "homepage": "https://github.com/dhava-gautama/dsh-grepmem#readme",
  "bugs": {
    "url": "https://github.com/dhava-gautama/dsh-grepmem/issues"
  },
  "scripts": {
    "test": "node --test"
  }
}

{
  "name": "@local/dsh-grepmem",
  "version": "1.0.0",
  "private": true,
  "description": "GrepMem-style lossless history recall for DeepSeek Harness: regex-search the full session log, including content removed by compaction.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "grep-worker.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "grep",
    "compaction"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
